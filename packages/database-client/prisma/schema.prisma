datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated" // ◄── CRITICAL: Forces Prisma to build types inside the package folder
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
}

enum UserRole {
  CUSTOMER
  BANK_ADMIN
}
